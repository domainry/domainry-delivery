{
  "version": "domainry-identity-bridge-config-v1",
  "installation_id": "domainry-delivery",
  "application_key": "domainry-delivery",
  "provider": {
    "key": "verdent-account",
    "verification": {
      "kind": "http_introspection",
      "endpoint": "https://login.verdent.ai/passport/token/validate",
      "method": "POST",
      "timeout": "3s",
      "max_response_bytes": 65536,
      "credential": {
        "location": "json",
        "name": "token"
      },
      "response": {
        "subject_id": "/data/user_id",
        "display_name": "/data/email",
        "email": "/data/email",
        "expires_at": "/data/expires_at",
        "expiry_format": "unix_seconds",
        "checks": [
          { "path": "/errCode", "equals": 0 },
          { "path": "/data/valid", "equals": true },
          { "path": "/data/token_type", "equals": "access" }
        ]
      }
    }
  },
  "personal_workspace": {
    "mode": "per_user",
    "create_on_first_access": true,
    "name_template": "Delivery workspace",
    "initial_role_keys": ["delivery_owner"]
  }
}
